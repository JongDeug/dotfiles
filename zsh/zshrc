# ============================================================
# zsh config
# ============================================================

# --- PATH ---------------------------------------------------
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
typeset -U path PATH fpath
path=("$HOME/.local/bin" $path)
path=("$HOME/.grok/bin" $path)
fpath=("$HOME/.grok/completions/zsh" $fpath)
fpath=("$HOME/.zsh/completions" $fpath)   # herdr completion zsh

# --- oh-my-zsh ----------------------------------------------
# custom/*.zsh 는 아래 source 시점에 자동 로드
# (macos-nfc, editor).
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=()
fpath=("$HOME/.zsh/plugins/zsh-completions/src" $fpath)
source "$ZSH/oh-my-zsh.sh"

# --- Environment --------------------------------------------
# EDITOR/VISUAL 은 custom/editor.zsh
export LANG="${LANG:-ko_KR.UTF-8}"
export PAGER="${PAGER:-less}"
export LESS="-R"

# --- History ------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY

# --- Options ------------------------------------------------
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP
setopt PROMPT_SUBST
setopt COMPLETE_IN_WORD
setopt ALWAYS_TO_END
setopt PATH_DIRS
setopt CORRECT
setopt EXTENDED_GLOB

# --- Completion ---------------------------------------------
# compinit 는 oh-my-zsh 가 이미 돌렸다.
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*' squeeze-slashes true
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.zsh/cache"
zstyle ':completion:*' complete-options true
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'

mkdir -p "$HOME/.zsh/cache"

# --- Aliases ------------------------------------------------
# ls/eza 한글 NFC 는 custom/macos-nfc.zsh 가 eza() 또는 ls 를 감싼다.
if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first'
  alias ll='eza -lh --git --group-directories-first'
  alias la='eza -lha --git --group-directories-first'
  alias tree='eza --tree'
else
  alias ll='ls -lhG'
  alias la='ls -lahG'
  alias l='ls -G'
fi
if (( $+commands[bat] )); then
  alias cat='bat --paging=never --style=plain'
fi
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias dl='cd ~/Downloads'
alias dt='cd ~/Desktop'
alias work='cd ~/Documents'
alias reload='exec zsh'
alias m1='~/.tmux/m1.sh'
alias path='echo -e ${PATH//:/\\n}'
alias ip='ipconfig getifaddr en0'
alias hidefiles='defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder'
alias showfiles='defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder'

# --- Keybindings --------------------------------------------
bindkey -e

# 단어 이동. 아래 bindkey 들은 그 자체로는 아무것도 못 한다 — Option 이 Meta 로
# 나가야 하고, 그건 iTerm2 쪽 설정이다:
#   Settings → Profiles → Keys → General → Left/Right Option key = "Esc+"
# 기본값 "Normal" 이면 Option+f 가 ƒ, Option+b 가 ∫ 로 입력되고 이 줄들은 영영
# 안 먹는다. Claude Code 같은 TUI 도 같은 이유로 단어 이동이 안 된다.
#
# Option+←/→ 는 herdr 이 탭 이동(alt+left/right)으로 먼저 먹는다. 터미널까지
# 내려오는 건 Option+b/f 쪽이다. Option+f 를 살리려고 AeroSpace 의
# workspace 13 을 alt-f → alt-g 로 옮겼다 (aerospace.toml).
bindkey '^[[1;3C' forward-word    # Option+→ (herdr 밖에서만)
bindkey '^[[1;3D' backward-word   # Option+←
bindkey '^[b' backward-word       # Option+b
bindkey '^[f' forward-word        # Option+f

# Delete word
bindkey '^[[3;3~' kill-word
bindkey '^[^?' backward-kill-word

# Home / End
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line

# --- Plugins ------------------------------------------------
# 바이너리는 repo 에 안 넣는다. ~/.zsh/plugins 에 clone.
ZSH_PLUGIN_DIR="$HOME/.zsh/plugins"

if [[ -f "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
  source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

if [[ -f "$ZSH_PLUGIN_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh" ]]; then
  source "$ZSH_PLUGIN_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh"
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
  bindkey '^P' history-substring-search-up
  bindkey '^N' history-substring-search-down
fi

if (( $+commands[fzf] )); then
  if (( $+commands[rg] )); then
    export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git"'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  fi
  source <(fzf --zsh)
fi

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"

  # Pick a git repo (frecent first) with fzf. Shared by c and j.
  _pick_dir() {
    { zoxide query -l; fd -Htd -d5 '^\.git$' ~/Documents -x dirname } \
      | awk '!seen[$0]++' | fzf -q "$*" -1
  }

  # Open the pick in VS Code + GitKraken. GitKraken has no PATH binary and no
  # document type -- gitkraken://repo/<abs path> is how a running instance takes it.
  c() { local d; d=$(_pick_dir "$@") || return; code "$d"; open "gitkraken://repo$d"; }
  j() { local d; d=$(_pick_dir "$@") && cd "$d"; }     # cd to the pick

  # herdr prefix+shift+J calls this from a popup. A custom command runs in its own
  # process and cannot cd the live pane, so it splits a new one instead.
  # Popups get no HERDR_PANE_ID -- HERDR_ACTIVE_PANE_ID is the tiled pane.
  # --direction is required; without it split exits with a usage error.
  _pane_at() {
    local d
    d=$(_pick_dir "$@") &&
      herdr pane split --pane "$HERDR_ACTIVE_PANE_ID" --direction right --cwd "$d"
  }
fi

# Syntax highlighting MUST be sourced last
if [[ -f "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# 머신 로컬만: ~/.zshrc.local
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# --- Claude Code 계정 전환 --------------------------------------
# cc-p → 개인 (jongdeug2021@gmail.com, ~/.claude)
# cc-w → 회사 (jonghwan.kim@themobilityone.com, ~/.claude-work)
# 설정(settings/skills/plugins/agents/projects)은 심볼릭 링크로 공유,
# 로그인 토큰만 config dir 별로 갈린다.
# cc-p 는 CLAUDE_CONFIG_DIR 를 "빼는" 쪽 — 이 변수를 ~/.claude 로 잡으면
# 설정을 ~/.claude/.claude.json 에서 찾아 로그인이 날아간다(기본은 ~/.claude.json).
# herdr 은 둘 다 같은 claude 바이너리라 프로필을 구분하지 못한다 — 띄우는 쪽이
# display_agent 를 덮어야 사이드바·페인 보더에 claude-work/claude-personal 로 뜬다.
_claude_herdr_label() {
  [[ ${HERDR_ENV:-} == 1 ]] || return 0
  herdr pane report-metadata "$HERDR_PANE_ID" --source claude-profile "$@" >/dev/null 2>&1
}
cc-p() { _claude_herdr_label --display-agent claude-personal; (unset CLAUDE_CONFIG_DIR; command claude "$@"); _claude_herdr_label --clear-display-agent }
cc-w() { _claude_herdr_label --display-agent claude-work; CLAUDE_CONFIG_DIR="$HOME/.claude-work" command claude "$@"; _claude_herdr_label --clear-display-agent }

export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
