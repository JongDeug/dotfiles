// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ssh_connections": [
    {
      "host": "m1-jdiu",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/jdiu"
          ]
        }
      ]
    }
  ],
  "diff_view_style": "split",
  "edit_predictions": {
    "mode": "eager"
  },
  "cli_default_open_behavior": "existing_window",
  "icon_theme": "Catppuccin Latte",
  "disable_ai": false,
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "mouse_wheel_zoom": true,
  "minimap": {
    "show": "always"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "fast": false,
        "model": "opus[1m]"
      },
      "type": "registry"
    }
  },
  "base_keymap": "Zed",
  "ui_font_size": 13.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "Catppuccin Macchiato"
  },
  // Popup of next keys after ctrl-space.
  "which_key": {
    "enabled": true,
    "delay_ms": 400
  },
  // Save before agents touch the same file.
  "autosave": "on_focus_change",
  // Installed on a fresh machine via the dotfiles symlink.
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "cutiepro-theme": true,
    "dockerfile": true,
    "emmet": true,
    "fleet-themes": true,
    "html": true,
    "material-icon-theme": true,
    "tsgo": true
  },
  // Inline blame is on by default; add the commit message.
  "git": {
    "inline_blame": { "show_commit_summary": true }
  },
  // Diagnostics marks need file_icons.
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "errors"
  },
  "colorize_brackets": true,
  "sticky_scroll": { "enabled": true },
  // Agent panel: system font for answers (Korean renders well), D2Coding for input/code.
  "agent_ui_font_family": ".SystemUIFont",
  "agent_ui_font_size": 14,
  "agent_buffer_font_family": "D2CodingLigature Nerd Font Mono",
  "agent_buffer_font_size": 13,
  "agent": {
    // Collapsed cards keep the thread readable; expand on click.
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "show_turn_stats": true,
    "message_editor_min_lines": 3,
    "play_sound_when_agent_done": "when_hidden",
    // Terminal threads start the real Claude Code CLI with the work config.
    "terminal_init_command": "CLAUDE_CONFIG_DIR=$HOME/.claude-work claude",
    // VS Code layout: chat on the right, threads list with it.
    "dock": "right",
    "threads_sidebar": { "position": "right" }
  },
  // VS Code layout: explorer, source control, outline share the left sidebar.
  "project_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  // No padding setting for the terminal; taller lines are the closest.
  "terminal": { "line_height": "comfortable", "dock": "bottom" },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
