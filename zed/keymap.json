// Zed defaults with vim mode (settings.json "vim_mode": true), plus a ctrl-space prefix like herdr's.
// which-key (settings.json) lists the prefix's keys after a pause.
[
  {
    // Free ctrl-space (completions in the editor) so the prefix isn't swallowed.
    "context": "Editor",
    "bindings": { "ctrl-space": null }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-space h": "workspace::ActivatePaneLeft",
      "ctrl-space j": "workspace::ActivatePaneDown",
      "ctrl-space k": "workspace::ActivatePaneUp",
      "ctrl-space l": "workspace::ActivatePaneRight",
      // The threads list on the left (herdr's ; is its sidebar too).
      "ctrl-space ;": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-space e": "project_panel::ToggleFocus",
      "ctrl-space t": "terminal_panel::Toggle",
      // a opens and closes the agent panel (cmd-b toggles the whole left dock, which the terminal shares).
      "ctrl-space a": "agent::Toggle",
      // A new Claude Code thread in it, kept in the threads list.
      "ctrl-space shift-a": "agent::NewTerminalThread",
      "ctrl-space g": "git_graph::Open",
      // The right dock's git panel (settings.json docks it right).
      "ctrl-space shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    // ctrl-space alone is Stage All in the git panel; free it for the prefix.
    "context": "GitPanel",
    "bindings": { "ctrl-space": null }
  },
  {
    // Claude Code newline: it reads a backslash before Enter as one.
    "context": "Terminal",
    "bindings": { "shift-enter": ["terminal::SendText", "\\\r\n"] }
  }
]
