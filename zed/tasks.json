[
  {
    // Full-size tab in the center; closes when lazygit exits cleanly.
    "label": "LazyGit",
    "command": "lazygit -p $ZED_WORKTREE_ROOT",
    "reveal_target": "center",
    "hide": "on_success",
    "show_summary": false,
    "show_command": false,
    "use_new_terminal": true,
    "allow_concurrent_runs": true
  }
]
