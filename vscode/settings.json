{
    "terminal.integrated.mouseWheelZoom": true,
    "editor.mouseWheelZoom": true,
    "geminicodeassist.project": "effortless-pulsar-mdpsm",
    "claudeCode.preferredLocation": "panel",
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.colorTheme": "Dark Modern",
    "remote.autoForwardPortsSource": "hybrid",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "explorer.confirmDragAndDrop": false,
    "typescript.experimental.useTsgo": true,
    "go.toolsManagement.autoUpdate": true,
    "terminal.integrated.suggest.enabled": false,
    "git.openRepositoryInParentFolders": "always",
    "explorer.confirmDelete": false,
    "security.promptForLocalFileProtocolHandling": false,
    "keyboard.dispatch": "keyCode",
    "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
    "zenMode.fullScreen": false,
    "zenMode.centerLayout": false,
    "zenMode.showTabs": "multiple",
    "zenMode.hideLineNumbers": false,
    "terminal.integrated.commandsToSkipShell": [
        "workbench.action.toggleSidebarVisibility",
        "workbench.action.toggleAuxiliaryBar",
        "workbench.action.toggleZenMode"
    ],
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "makefile.configureOnOpen": false,
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "diffEditor.ignoreTrimWhitespace": true,
    "claudeCode.hideOnboarding": true,
    "gitlens.graph.details.location": "auto",
    "gitlens.views.scm.grouped.views": {
        "commits": true,
        "branches": true,
        "remotes": true,
        "stashes": true,
        "tags": true,
        "worktrees": true,
        "contributors": true,
        "fileHistory": false,
        "repositories": true,
        "searchAndCompare": true,
        "launchpad": false
    },
    "window.zoomLevel": -1,
    "gitlens.graph.scrollMarkers.additionalTypes": [],
    "gitlens.graph.layout": "editor"
}
