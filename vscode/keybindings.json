[
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\\\r\n"
    },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+space",
    "command": "-editor.action.triggerSuggest",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+j",
    "command": "-workbench.action.togglePanel"
  },
  {
    "key": "ctrl+h",
    "command": "-editor.action.startFindReplaceAction",
    "when": "editorFocus || editorIsOpen"
  },
  {
    "key": "space shift+/",
    "command": "vscode-neovim.send",
    "args": "<Space>?",
    "when": "editorTextFocus && neovim.mode == normal && !terminalFocus"
  },
  {
    "key": "space e",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.view.explorer",
        "workbench.files.action.focusFilesExplorer"
      ]
    },
    "when": "neovim.mode == normal && !terminalFocus && !inputFocus && !suggestWidgetVisible && !filesExplorerFocus"
  },
  {
    "key": "space e",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.view.explorer",
        "workbench.files.action.focusFilesExplorer"
      ]
    },
    "when": "!editorTextFocus && !terminalFocus && !inputFocus && !filesExplorerFocus"
  },
  {
    "key": "space e",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "space f f",
    "command": "workbench.action.quickOpen",
    "when": "editorTextFocus && neovim.mode == normal && !terminalFocus"
  },
  {
    "key": "space /",
    "command": "workbench.action.findInFiles",
    "when": "editorTextFocus && neovim.mode == normal && !terminalFocus"
  },
  {
    "key": "space b d",
    "command": "workbench.action.closeActiveEditor",
    "when": "editorTextFocus && neovim.mode == normal && !terminalFocus"
  },
  {
    "key": "space g s",
    "command": "workbench.view.scm",
    "when": "!terminalFocus && !inputFocus && neovim.mode != insert"
  },
  {
    "key": "space g l",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.focusFirstEditorGroup",
        "gitlens.showGraphPage"
      ]
    },
    "when": "!terminalFocus && !inputFocus && neovim.mode != insert"
  },
  {
    "key": "space d b",
    "command": "editor.debug.action.toggleBreakpoint",
    "when": "editorTextFocus && neovim.mode == normal && !terminalFocus"
  },
  {
    "key": "ctrl+space h",
    "command": "workbench.action.navigateLeft"
  },
  {
    "key": "ctrl+space l",
    "command": "workbench.action.navigateRight"
  },
  {
    "key": "ctrl+space j",
    "command": "workbench.action.navigateDown"
  },
  {
    "key": "ctrl+space k",
    "command": "workbench.action.navigateUp"
  },
  {
    "key": "ctrl+space ;",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+space ;",
    "command": "workbench.action.terminal.focus",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.toggleAuxiliaryBar",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.togglePanel",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.toggleZenMode",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+/",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "!terminalFocus && !inputFocus"
  },
  {
    "key": "ctrl+/",
    "command": "workbench.action.togglePanel",
    "when": "terminalFocus"
  }
]
